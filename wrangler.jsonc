/**
 * Free-tier Cloudflare Workers + static assets + D1.
 * Do NOT enable Workers Paid, Durable Objects, or paid add-ons.
 * Set ADMIN_SECRET with: npx wrangler secret put ADMIN_SECRET
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "language-learning",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "language-learning-db",
      "database_id": "a381213c-f0a9-46e4-ab3b-d648efdbb61e",
      "migrations_dir": "migrations"
    }
  ]
}
